{
  "manifest_version": 3,
  "name": "SignalX Quotex Chart Bridge",
  "version": "0.3.0",
  "description": "SignalX floating chart overlay. Reads validated candle data from the current Quotex chart; no external market-data API.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.quotex.io/*",
    "https://*.quotex.com/*",
    "https://*.qxbroker.com/*"
  ],
  "action": {
    "default_title": "SignalX"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.quotex.io/*",
        "https://*.quotex.com/*",
        "https://*.qxbroker.com/*"
      ],
      "js": [
        "signal-engine.js",
        "adapter.js",
        "overlay.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.quotex.io/*",
        "https://*.quotex.com/*",
        "https://*.qxbroker.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
